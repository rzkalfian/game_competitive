<?xml version="1.0" encoding="UTF-8"?>
<svg id="tug-of-war-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 460 460" width="100%" height="100%">
                            <defs>
                                <!-- Gaya CSS Internal di dalam SVG untuk Animasi & Variabel Warna Baju -->
                                <style id="svg-internal-style">
                                    #tug-of-war-svg {
                                        --shirt-main: #D92B2B;
                                        --shirt-shade: #B01E1E;
                                        --shirt-highlight: #E84545;
                                        --shorts-main: #F8FAFC;
                                        --shorts-shade: #CBD5E1;
                                        --outline: #2C1A12;
                                        --skin-main: #DE9366;
                                        --skin-shade: #C2774B;
                                        --hair-main: #2E221D;
                                        --hair-highlight: #47362E;
                                        --rope-main: #B88655;
                                        --rope-shade: #8A5E34;
                                        --rope-highlight: #D9A978;
                                        --anim-duration: 1.3s;
                                        --anim-state: running;
                                    }

                                    /* Animasi Tarikan Tubuh Atas &amp; Lengan */
                                    @keyframes tugPullBody {
                                        0%, 100% {
                                            transform: rotate(0deg) translate(0px, 0px);
                                        }
                                        45% {
                                            transform: rotate(-4.5deg) translate(-6px, 2px);
                                        }
                                        60% {
                                            transform: rotate(-5.2deg) translate(-7px, 2.5px);
                                        }
                                        85% {
                                            transform: rotate(1deg) translate(1.5px, -0.5px);
                                        }
                                    }

                                    /* Animasi Kepala Menahan Beban */
                                    @keyframes headStrain {
                                        0%, 100% {
                                            transform: rotate(0deg) translate(0px, 0px);
                                        }
                                        50% {
                                            transform: rotate(-3.5deg) translate(-3px, 1px);
                                        }
                                    }

                                    /* Animasi Tali Tambang Tegang &amp; Bergetar Halus */
                                    @keyframes ropeTensePull {
                                        0%, 100% {
                                            transform: translateX(0px) translateY(0px);
                                        }
                                        25% {
                                            transform: translateX(-3px) translateY(-0.6px);
                                        }
                                        50% {
                                            transform: translateX(-7px) translateY(1.2px);
                                        }
                                        75% {
                                            transform: translateX(-4px) translateY(-0.5px);
                                        }
                                    }

                                    /* Animasi Ayunan Lembut Tali Menjuntai di Depan Paha */
                                    @keyframes ropeTailSwing {
                                        0%, 100% {
                                            transform: rotate(0deg) translate(0px, 0px);
                                        }
                                        45% {
                                            transform: rotate(-4deg) translate(-5px, 2px);
                                        }
                                        60% {
                                            transform: rotate(-5.2deg) translate(-6px, 2.5px);
                                        }
                                        85% {
                                            transform: rotate(2.5deg) translate(2px, -1px);
                                        }
                                    }

                                    /* Animasi Ikat Kepala Merah Putih Berkibar */
                                    @keyframes ribbonFlutterTop {
                                        0%, 100% {
                                            transform: rotate(0deg) skewY(0deg);
                                        }
                                        35% {
                                            transform: rotate(6deg) skewY(-3deg);
                                        }
                                        70% {
                                            transform: rotate(-4deg) skewY(2deg);
                                        }
                                    }

                                    @keyframes ribbonFlutterBottom {
                                        0%, 100% {
                                            transform: rotate(0deg) skewY(0deg);
                                        }
                                        40% {
                                            transform: rotate(-7deg) skewY(3deg);
                                        }
                                        75% {
                                            transform: rotate(5deg) skewY(-2deg);
                                        }
                                    }

                                    /* Animasi Garis Debu / Gesekan Kaki */
                                    @keyframes dustPulse {
                                        0%, 100% {
                                            opacity: 0.35;
                                            transform: translateX(0px) scale(0.95);
                                        }
                                        50% {
                                            opacity: 0.95;
                                            transform: translateX(-4px) scale(1.06);
                                        }
                                    }

                                    /* Animasi Bayangan Tanah */
                                    @keyframes shadowStretch {
                                        0%, 100% {
                                            transform: scaleX(1);
                                        }
                                        50% {
                                            transform: scaleX(1.04) translateX(-3px);
                                        }
                                    }

                                    .anim-upper-body {
                                        transform-origin: 215px 265px;
                                        animation: tugPullBody var(--anim-duration) ease-in-out infinite;
                                        animation-play-state: var(--anim-state);
                                    }

                                    .anim-head {
                                        transform-origin: 205px 175px;
                                        animation: headStrain var(--anim-duration) ease-in-out infinite;
                                        animation-play-state: var(--anim-state);
                                    }

                                    .anim-rope-tense {
                                        animation: ropeTensePull var(--anim-duration) ease-in-out infinite;
                                        animation-play-state: var(--anim-state);
                                    }

                                    .anim-rope-front-tail {
                                        transform-origin: 218px 232px;
                                        animation: ropeTailSwing var(--anim-duration) ease-in-out infinite;
                                        animation-play-state: var(--anim-state);
                                    }

                                    .anim-ribbon-1 {
                                        transform-origin: 122px 116px;
                                        animation: ribbonFlutterTop 0.95s ease-in-out infinite;
                                        animation-play-state: var(--anim-state);
                                    }

                                    .anim-ribbon-2 {
                                        transform-origin: 124px 122px;
                                        animation: ribbonFlutterBottom 1.1s ease-in-out infinite;
                                        animation-play-state: var(--anim-state);
                                    }

                                    .anim-dust {
                                        transform-origin: 210px 395px;
                                        animation: dustPulse var(--anim-duration) ease-in-out infinite;
                                        animation-play-state: var(--anim-state);
                                    }

                                    .anim-shadow {
                                        transform-origin: 255px 412px;
                                        animation: shadowStretch var(--anim-duration) ease-in-out infinite;
                                        animation-play-state: var(--anim-state);
                                    }

                                    /* Kelas Warna Baju &amp; Celana */
                                    .shirt-fill { fill: var(--shirt-main); transition: fill 0.2s ease; }
                                    .shirt-shade-fill { fill: var(--shirt-shade); transition: fill 0.2s ease; }
                                    .shirt-highlight-fill { fill: var(--shirt-highlight); transition: fill 0.2s ease; }
                                    .shorts-fill { fill: var(--shorts-main); transition: fill 0.2s ease; }
                                    .shorts-shade-fill { fill: var(--shorts-shade); transition: fill 0.2s ease; }
                                </style>

